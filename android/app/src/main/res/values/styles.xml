<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!--
      스플래시 테마. 스플래시는 이 테마를 쓰는 Dialog로 그려지므로, 시스템 바까지 브랜드 색으로
      덮으려면 여기서 지정해야 한다. 다이얼로그가 떠 있는 동안만 적용된다.

      다만 이 테마는 액티비티 창에도 먼저 적용되고, bootsplash는 setTheme만 할 뿐 창에 적용된
      바 색은 되돌리지 않는다. 그래서 MainActivity에서 AppTheme 기준으로 다시 맞춰준다.
    -->
    <style name="BootTheme" parent="Theme.BootSplash">
        <item name="bootSplashBackground">@color/bootsplash_background</item>
        <item name="bootSplashLogo">@drawable/bootsplash_logo</item>
        <item name="postBootSplashTheme">@style/AppTheme</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/bootsplash_background</item>
        <item name="android:navigationBarColor">@color/bootsplash_background</item>
        <!-- 배경이 진한 브랜드 색이라 바 아이콘은 밝게 -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
