# React Native CocoaPods 스크립트를 Node.js로 로드해서 hoisting 문제 해결
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )',
  __dir__
]).strip

# iOS 최소 지원 버전을 React Native 스크립트가 자동으로 채워줌
platform :ios, min_ios_version_supported
prepare_react_native_project!

# Flipper 설정 (NO_FLIPPER=1 로 비활성화 가능)
flipper_config = ENV['NO_FLIPPER'] == "1" ? FlipperConfiguration.disabled : FlipperConfiguration.enabled

# -- 만약 USE_FRAMEWORKS 환경 변수를 넣어서 동적 프레임워크를 쓰고 싶다면 아래 주석을 해제 -- #
# linkage = ENV['USE_FRAMEWORKS']
# if linkage
#   Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
#   use_frameworks! :linkage => linkage.to_sym
# end

target 'LetMeDoWith' do
  # 자동으로 link할 네이티브 모듈 설정 정보 로드
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    :flipper_configuration => flipper_config,
    # 실제 앱 경로 (Podfile 위치 기준 상위 폴더)
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # 테스트 대상
  target 'LetMeDoWithTests' do
    inherit! :complete
    # 여기에 테스트 전용 Pods 추가 가능
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false      # Mac Catalyst 비활성화
    )
    # (Xcode 12.5 M1 문제 대응이 필요하면 여기에 추가 스크립트 삽입)
  end
end
