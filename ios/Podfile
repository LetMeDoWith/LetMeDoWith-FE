# React Native CocoaPods 스크립트를 Node.js로 로드해서 hoisting 문제 해결
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )',
  __dir__
]).strip


# iOS 최소 지원 버전 지정
platform :ios, '15.0'
prepare_react_native_project!

# Flipper Off
flipper_config = FlipperConfiguration.disabled

# 정적 프레임워크(Flipper-Boost와 충돌 안 남, 모듈맵 생성 용이)
use_frameworks! :linkage => :static

target 'LetMeDoWith' do
  # 자동으로 link할 네이티브 모듈 설정 정보 로드
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :flipper_configuration => flipper_config,
    # 실제 앱 경로 (Podfile 위치 기준 상위 폴더)
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # --- RNFB 18.9.0과 맞추기: Firebase 혼합 방지 (10.20.0 고정) ---
  $FB = '10.20.0'
  pod 'FirebaseCoreInternal',  $FB
  pod 'FirebaseInstallations', $FB
  # Swift + 정적 통합 시 모듈 문제 예방
  pod 'GoogleUtilities',     :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'PromisesObjC',        :modular_headers => true
  # -------------------------------------------------------------

  # 테스트 대상
  target 'LetMeDoWithTests' do
    inherit! :complete
    # 여기에 테스트 전용 Pods 추가 가능
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false      # Mac Catalyst 비활성화
    )
    
    installer.pods_project.targets.each do |t|
      # 배포 타깃 통일
      t.build_configurations.each do |c|
        c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
