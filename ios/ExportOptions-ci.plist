<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>development</string>
    <!--
      signingStyle은 automatic이어야 한다.
      이 프로젝트가 쓰는 "iOS Team Provisioning Profile"은 Xcode가 자동 관리하는
      프로파일이라, manual로 지정하면
      "profile is Xcode managed, but signing settings require a manually managed profile"
      로 export가 실패한다. 프로파일 자체는 앞 단계에서 러너에 설치해 두므로,
      automatic이어도 계정 로그인 없이 그것을 찾아 쓴다.
    -->
    <key>signingStyle</key>
    <string>automatic</string>
    <key>teamID</key>
    <string>U3N4285KF6</string>
    <key>destination</key>
    <string>export</string>
    <key>compileBitcode</key>
    <false/>
    <key>stripSwiftSymbols</key>
    <true/>
</dict>
</plist>
